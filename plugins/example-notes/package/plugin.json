{
  "apiVersion": 1,
  "hostApi": 1,
  "id": "example-notes",
  "name": "项目备忘",
  "version": "1.1.0",
  "description": "最小自定义插件示例，使用独立存储并向会话贡献备忘资源。",
  "permissions": [
    "storage.read",
    "storage.write",
    "conversation.context"
  ],
  "page": {
    "title": "项目备忘",
    "kind": "records"
  },
  "records": {
    "storage": "private",
    "resourceType": "note",
    "fields": [
      {
        "key": "title",
        "label": "标题",
        "type": "text",
        "required": true,
        "maxLength": 200
      },
      {
        "key": "details",
        "label": "正文",
        "type": "textarea",
        "maxLength": 8000
      }
    ]
  },
  "commands": [
    {
      "id": "cite",
      "label": "引用到会话",
      "action": "conversation.context"
    }
  ],
  "category": "application",
  "tags": [
    "项目备忘"
  ],
  "author": "Delivery 插件维护者",
  "compatibility": {
    "protocol": 1,
    "sdk": "2.1.0"
  },
  "theme": "full",
  "releaseNotes": "独立发布包；新增分类、公开主题通知和能力用途说明。",
  "dependencies": [],
  "capabilities": [
    {
      "id": "storage.read",
      "required": true,
      "purpose": "使用此插件声明的数据和记录操作",
      "scope": "宿主受控接口，限当前插件已声明的资源"
    },
    {
      "id": "storage.write",
      "required": false,
      "purpose": "使用此插件声明的数据和记录操作",
      "scope": "宿主受控接口，限当前插件已声明的资源"
    },
    {
      "id": "conversation.context",
      "required": false,
      "purpose": "使用此插件声明的数据和记录操作",
      "scope": "宿主受控接口，限当前插件已声明的资源"
    }
  ]
}
