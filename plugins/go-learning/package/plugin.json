{
  "apiVersion": 1,
  "hostApi": 2,
  "id": "go-learning",
  "name": "Go 实训工坊",
  "version": "1.1.0",
  "description": "独立的七天 Go 实训：课程、代码编辑、快照、真实运行测试与 HTTP 调试。",
  "permissions": [
    "storage.read",
    "application.local",
    "conversation.compose",
    "workspace.open"
  ],
  "page": {
    "title": "Go 实训工坊",
    "kind": "application"
  },
  "application": {
    "frontend": "ui.js",
    "styles": "ui.css",
    "backend": "server.mjs"
  },
  "records": {
    "storage": "private",
    "resourceType": "note",
    "fields": [
      {
        "key": "title",
        "label": "标题",
        "type": "text",
        "required": true
      }
    ]
  },
  "commands": [],
  "category": "application",
  "tags": [
    "Go 实训工坊"
  ],
  "author": "Delivery 插件维护者",
  "compatibility": {
    "protocol": 1,
    "sdk": "2.1.0"
  },
  "theme": "full",
  "releaseNotes": "独立发布包；新增分类、公开主题通知和能力用途说明。",
  "dependencies": [
    "本机 Go 工具链（运行与测试）"
  ],
  "capabilities": [
    {
      "id": "storage.read",
      "required": true,
      "purpose": "使用此插件声明的数据和记录操作",
      "scope": "宿主受控接口，限当前插件已声明的资源"
    },
    {
      "id": "application.local",
      "required": true,
      "purpose": "运行插件自身页面和后端",
      "scope": "当前用户的本机文件和网络；非操作系统沙箱"
    },
    {
      "id": "conversation.compose",
      "required": false,
      "purpose": "将选择的内容填入会话草稿",
      "scope": "宿主受控接口，限当前插件已声明的资源"
    },
    {
      "id": "workspace.open",
      "required": false,
      "purpose": "打开本插件工作目录",
      "scope": "宿主受控接口，限当前插件已声明的资源"
    }
  ]
}
