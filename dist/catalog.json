    {
      "id": "alert-hub",
      "version": "1.1.0",
      "manifest": {
        "apiVersion": 1,
        "id": "alert-hub",
        "name": "告警中心",
        "version": "1.1.0",
        "hostApi": 2,
        "description": "通过本机 MCP 管理告警、Case、待办、负责人和规则；独立插件界面，账号密码配置化，远端写入须确认。",
        "category": "application",
        "tags": [
          "告警中心"
        ],
        "author": "Delivery 插件维护者",
        "releaseNotes": "独立发布包；新增分类、公开主题通知和能力用途说明。",
        "compatibility": {
          "protocol": 1,
          "sdk": "2.1.0"
        },
        "theme": "full",
        "dependencies": [
          "Alert Hub 服务、自己的账号及本机 alert-hub-mcp"
        ],
        "capabilities": [
          {
            "id": "storage.read",
            "required": true,
            "purpose": "使用此插件声明的数据和记录操作",
            "scope": "宿主受控接口，限当前插件已声明的资源"
          },
          {
            "id": "application.local",
            "required": true,
            "purpose": "运行插件自身页面和后端",
            "scope": "当前用户的本机文件和网络；非操作系统沙箱"
          },
          {
            "id": "conversation.compose",
            "required": false,
            "purpose": "将选择的内容填入会话草稿",
            "scope": "宿主受控接口，限当前插件已声明的资源"
          }
        ],
        "permissions": [
          "storage.read",
          "application.local",
          "conversation.compose"
        ],
        "page": {
          "title": "告警中心",
          "kind": "application"
        },
        "application": {
          "frontend": "ui.js",
          "styles": "ui.css",
          "backend": "server.mjs"
        },
        "configuration": {
          "fields": [
            {
              "key": "endpoint",
              "label": "Alert Hub 服务地址",
              "type": "text",
              "description": "账号密码将用于此 HTTPS 服务的真实登录，请核对地址。",
              "required": true,
              "default": "https://thor-alert-hub.hahavending.com"
            },
            {
              "key": "command",
              "label": "MCP 可执行文件",
              "type": "text",
              "description": "填写本机 alert-hub-mcp 的绝对路径，例如 /Users/你的用户名/.local/bin/alert-hub-mcp。",
              "required": true
            },
            {
              "key": "username",
              "label": "账号",
              "type": "text",
              "required": true
            },
            {
              "key": "password",
              "label": "密码",
              "type": "password",
              "description": "留空保留原密码；更换服务地址或账号时必须重新填写。",
              "required": true,
              "resetOnChange": [
                "endpoint",
                "username"
              ]
            }
          ]
        },
        "records": {
          "storage": "private",
          "resourceType": "alert",
          "fields": [
            {
              "key": "title",
              "label": "标题",
              "type": "text",
              "required": true,
              "maxLength": 2000,
              "default": ""
            }
          ]
        },
        "commands": []
      },
      "package": "alert-hub-1.1.0.dwp",
      "sha256": "4fd223cc382435bf1e06a6982d080912d47655d83c3c77cdfd1504835b617b39"
    },
