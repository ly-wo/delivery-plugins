                },
                {
                  "value": "guarded",
                  "label": "已补防复发测试"
                },
                {
                  "value": "archived",
                  "label": "已归档复用"
                }
              ],
              "maxLength": 2000,
              "default": "analyzing"
            },
            {
              "key": "regressionAdded",
              "label": "已补自动化回归用例",
              "type": "checkbox",
              "required": false,
              "maxLength": 2000,
              "default": "false"
            },
            {
              "key": "prUrl",
              "label": "修复提交 / MR 链接",
              "type": "url",
              "required": false,
              "maxLength": 500,
              "default": ""
            },
            {
              "key": "tags",
              "label": "根因分类标签",
              "type": "tags",
              "required": false,
              "maxLength": 400,
              "default": ""
            },
            {
              "key": "details",
              "label": "根因分析与防复发措施",
              "type": "textarea",
              "required": false,
              "maxLength": 8000,
              "default": ""
            }
          ]
        },
        "commands": [
          {
            "id": "cite",
            "label": "作为经验注入会话",
            "action": "conversation.context"
          },
          {
            "id": "link-jira",
            "label": "关联原缺陷 Jira",
            "action": "jira.link"
          }
        ]
      },
